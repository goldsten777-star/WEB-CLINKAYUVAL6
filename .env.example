# Supabase project (Project Settings > API). Safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Gemini API key from Google AI Studio. Server only, never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: first model to try (default: gemini-flash-lite-latest)
# GEMINI_MODEL=

# Optional: full site address, used to show "https://.../slug" in the dashboard
# NEXT_PUBLIC_SITE_URL=https://hanoch-clinic.vercel.app
